# ── Secrets — nunca commitear ──────────────────────────────────
.env
.env.*
!.env.example
!.env.*.example

# ── Node / Next.js ──────────────────────────────────────────────
node_modules/
.next/
out/
.vercel/
*.tsbuildinfo
npm-debug.log*

# ── Python ───────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
.venv/
venv/
env/
*.egg-info/
.pytest_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# ── Modelos locales de embeddings (se descargan en runtime) ──────
.cache/
*.gguf

# ── InfraCortex / motor-estructural — pesos YOLO (se descargan en runtime) ─
*.pt

# ── Sistema operativo / editor ────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/
.idea/

# ── Normativa fuente cruda (privada, no redistribuible) ───────────
packages/construdata/normativa_raw/
scripts/ingesta/*/raw/
scripts/ingesta/sgsst_raw/
scripts/ingesta/ras_audit/
scripts/ingesta/preview_*.txt
# Salida de scratch de cada corrida de scripts/evaluacion/ragas_baseline_nsr10.py
# -- los snapshots que sí vale la pena conservar se renombran a mano a
# baseline_<fecha>_*.* (esos SÍ se versionan, ver baseline_2026-08-27_*.*).
scripts/evaluacion/_muestras.jsonl
scripts/evaluacion/_resultados.csv

# ── Dataset de fotos de obra reales (personas identificables, sitio real) ──
# El modelo.onnx entrenado SÍ se puede commitear (deliberado, binario
# pequeño) — lo que NO debe salir al repo público son las fotos originales
# ni los artefactos de entrenamiento (checkpoints, runs, dataset etiquetado).
packages/yolo/dataset/
packages/yolo/runs/
packages/yolo/*.pt
scripts/satelite/_cache/
scripts/secop/_cache/
scripts/precios/_cache/
scripts/macro/_cache/

# Muestras de susceptibilidad (15 MB, reproducibles con muestrear_susceptibilidad.py y agregar_cobertura_worldcover.py)
scripts/satelite/susceptibilidad_muestras*.csv

# Cachés de descarga de scripts/clima (temperatura IDEAM, TNA), reproducibles con extraer_temperatura_caribe.py
scripts/clima/_cache/
scripts/clima/*.log
scripts/datos/*.log
scripts/hidro/*.log

# Cachés locales de análisis hidrológico (regenerables)
scripts/hidro/_cache/
scripts/hidro/_*.log
data/precios_elementos/_cache/

# regenerable con scripts/precios/indices_dane.py (6 MB)
data/precios_elementos/indices_icoced.csv
data/laboratorio_concreto/_cache/

data/transporte/_cache/

# Datos de terceros (APU de colegas, permiso de uso para StructAI, no para publicar)
scripts/presupuesto/_privado/

# Claves locales de seudonimización (SECOP)
scripts/ingesta/*/_privado/
