# URL del FastAPI backend (apps/api)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Sentry (opcional en dev — sin esto, la app funciona igual y Sentry no se activa)
# DSN del proyecto structai en sentry.io (Settings > Client Keys)
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
# Solo para build de producción con sourcemaps legibles (no en local):
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=
